<!doctype html><html><head><title>{{ .Conf.Desc }} · Studio</title>{{ block "header" . }}{{ end }}{{ template "admin_favicon" .Conf }}<link rel="stylesheet" href="/static/css/studio.css?v=25"></head>
<body class="btcpp-admin-page">{{ block "mainnav" . }}{{ end }}
